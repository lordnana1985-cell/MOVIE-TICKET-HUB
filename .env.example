# NODE_ENV: Runtime environment mode (development, production, or test)
NODE_ENV=development

# VITEST: Set to 'true' when running Vitest test suite to suppress excessive logging
VITEST=

# GEMINI_API_KEY: Required for Gemini AI API calls (synopsis generation, chat assistant).
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
APP_URL="MY_APP_URL"

# PAYSTACK_SECRET_KEY: Your Paystack API private key for processing 80/20 splits.
PAYSTACK_SECRET_KEY=

# IS_TEST_ENV: Flag to indicate test execution environment (bypasses live network checks)
IS_TEST_ENV=

# ERROR_TRACKING_ENDPOINT: Optional endpoint URL for HTTP error logging / telemetry
ERROR_TRACKING_ENDPOINT=
VITE_ERROR_TRACKING_ENDPOINT=

# SENTRY_DSN: Optional Sentry DSN for backend error tracking and stack trace captures.
SENTRY_DSN=
VITE_SENTRY_DSN=

# VITE_SUPABASE_URL: Supabase Project URL
VITE_SUPABASE_URL=

# VITE_SUPABASE_ANON_KEY: Supabase Anon / Public API Key
VITE_SUPABASE_ANON_KEY=

# DISABLE_HMR: Set to true in preview environments to prevent rebuild flickering during edits
DISABLE_HMR=
