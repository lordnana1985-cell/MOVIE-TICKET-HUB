# GEMINI_API_KEY: Injected automatically by AI Studio for Gemini AI features.
GEMINI_API_KEY=

# PAYSTACK_SECRET_KEY: Optional. For real payments, get this from https://dashboard.paystack.com (Settings > API Keys & Webhooks).
# If left empty, the app runs in built-in Demo Checkout Mode.
PAYSTACK_SECRET_KEY=

# VITE_SUPABASE_URL & VITE_SUPABASE_ANON_KEY: Optional. From your Supabase Project Settings > API.
# If left empty, the app seamlessly uses local browser storage.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# SENTRY_DSN / VITE_SENTRY_DSN: Optional. Error monitoring DSN from https://sentry.io
VITE_SENTRY_DSN=

