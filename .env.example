# Environment & Node runtime mode ('development', 'production', 'test')
NODE_ENV=development

# Structured logging level for Pino ('debug', 'info', 'warn', 'error', 'silent')
LOG_LEVEL=info

# GEMINI_API_KEY: Injected automatically by AI Studio for Gemini AI features
GEMINI_API_KEY=

# PAYSTACK_SECRET_KEY: For live payments from https://dashboard.paystack.com (Settings > API Keys & Webhooks)
# If left empty, the app runs in built-in Demo Checkout & Simulation mode
PAYSTACK_SECRET_KEY=

# Supabase database URLs (client & server fallbacks)
# From your Supabase Project Settings > API. If left empty, the app seamlessly uses local browser storage
VITE_SUPABASE_URL=
SUPABASE_URL=

# Supabase public anonymous API keys
VITE_SUPABASE_ANON_KEY=
SUPABASE_ANON_KEY=

# Supabase elevated service role key (optional server-side operations)
SUPABASE_SERVICE_ROLE_KEY=

# Sentry error monitoring DSN from https://sentry.io (server and client error tracking)
SENTRY_DSN=
VITE_SENTRY_DSN=

# Custom error tracking telemetry endpoint (optional fallback)
ERROR_TRACKING_ENDPOINT=

